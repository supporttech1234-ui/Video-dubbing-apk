/* =========================
   PROGRESS
========================= */

function startProgress() {

    if (progressTimer) {

        clearInterval(progressTimer);

    }


    let progress = 0;


    progressTimer =
        setInterval(function () {

            progress += 2;


            document
                .getElementById("progressNumber")
                .innerText =
                progress + "%";


            document
                .getElementById("progressFill")
                .style.width =
                progress + "%";


            updateTime(progress);


            if (progress < 20) {

                document
                    .getElementById("processName")
                    .innerText =
                    "Uploading movie...";

            }

            else if (progress < 40) {

                document
                    .getElementById("processName")
                    .innerText =
                    "Preparing media...";

            }

            else if (progress < 60) {

                document
                    .getElementById("processName")
                    .innerText =
                    "Transcribing speech...";

            }

            else if (progress < 75) {

                document
                    .getElementById("processName")
                    .innerText =
                    "Translating dialogue...";

            }

            else if (progress < 90) {

                document
                    .getElementById("processName")
                    .innerText =
                    "Generating voices...";

            }

            else if (progress < 100) {

                document
                    .getElementById("processName")
                    .innerText =
                    "Exporting final file...";

            }

            else {

                clearInterval(
                    progressTimer
                );


                document
                    .getElementById("processName")
                    .innerText =
                    "Dubbing complete";


                document
                    .getElementById("progressNumber")
                    .innerText =
                    "100%";


                document
                    .getElementById("progressFill")
                    .style.width =
                    "100%";


                setTimeout(
                    showComplete,
                    500
                );

            }

        }, 150);

}


