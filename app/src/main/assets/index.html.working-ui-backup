<style>

/* =========================
   BASIC
========================= */

* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

body {
    margin: 0;
    padding: 0;
    background: #080b10;
    color: white;
    font-family: Arial, sans-serif;
    min-height: 100vh;
}
button,
input,
select {
    font-family: Arial, sans-serif;
}
/* LANGUAGE SEARCH */
.language-select-box {
    width: 100%;
    box-sizing: border-box;
    padding: 14px;
    border: 1px solid #1d3540;
    border-radius: 12px;
    background: #0d151b;
    color: white;
    font-size: 15px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
}

.language-arrow {
    color: #71808a;
    font-size: 12px;
}

.language-panel {
    display: none;
    margin-top: 8px;
}

#languageSearch, #dubLanguageSearch {
    width: 100%;
    box-sizing: border-box;
    padding: 14px;
    margin-top: 4px;
    margin-bottom: 10px;
    border: 1px solid #1d3540;
    border-radius: 12px;
    outline: none;
    background: #0d151b;
    color: white;
    font-size: 15px;
}

#languageSearch::placeholder, #dubLanguageSearch::placeholder {
    color: #71808a;
}

.language-list {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.language-option {
    display: grid;
    grid-template-columns: 48px 1fr;
    grid-template-rows: auto auto;
    column-gap: 12px;
    align-items: center;
    min-height: 68px;
    box-sizing: border-box;
    padding: 13px 14px;
    border: 1px solid #1d3540;
    border-radius: 12px;
    background: #0d151b;
    color: white;
    font-size: 15px;
    cursor: pointer;
}

.language-flag {
    grid-row: 1 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #171622;
    font-size: 25px;
}

.language-name {
    grid-column: 2;
    font-size: 16px;
    font-weight: 600;
    line-height: 22px;
}

.language-subtitle {
    grid-column: 2;
    font-size: 13px;
    color: #8f8a9d;
    line-height: 19px;
}


.language-option.selected {
    box-shadow: 0 0 0 1px rgba(160, 130, 255, 0.25);

    border-color: #00ffff;
    background: #10252d;
}

.language-option:hover {
    background: #10252d;
}

button {
    cursor: pointer;
}

/* =========================
   HOME
========================= */

#homeScreen {
    min-height: 100vh;
    padding: 22px;
    background: #080b10;
}

.header {
