<script>

/* =========================
   VARIABLES
========================= */

let selectedVideo = null;

let voiceMode = "multi";

let progressTimer = null;

let startTime = 0;


/* =========================
   GALLERY
========================= */

function openGallery() {

    document
        .getElementById("videoPicker")
        .click();

}


/* =========================
   AUDIO
========================= */

function openAudio() {

    document
        .getElementById("filePicker")
        .click();

}


/* =========================
   VIDEO SELECTED
========================= */

function videoSelected(event) {

    const file =
        event.target.files[0];

    if (!file) {
        return;
    }


    selectedVideo = file;


    document
        .getElementById("homeScreen")
        .style.display = "none";


    document
        .getElementById("videoScreen")
        .style.display = "block";


    document
        .getElementById("selectedMovieName")
        .innerText = file.name;


    const video =
        document.getElementById("videoPreview");


    video.src =
        URL.createObjectURL(file);


    video.style.display = "block";

}


/* =========================
   CLOSE VIDEO
========================= */

function fileSelected(event) {

    const file = event.target.files[0];

    if (!file) {
        return;
    }

    if (file.type.startsWith("video/")) {
        selectedVideo = file;
    } else if (file.type.startsWith("audio/")) {
        window.selectedAudio = file;
        selectedVideo = null;
    } else {
        alert("Please select a video or audio file.");
        return;
    }

    document.getElementById("homeScreen").style.display = "none";
    document.getElementById("videoScreen").style.display = "block";
    document.getElementById("selectedMovieName").innerText = file.name;

    const video = document.getElementById("videoPreview");
    const audio = document.getElementById("audioPreview");

    if (file.type.startsWith("video/")) {

        audio.pause();
        audio.removeAttribute("src");
        audio.style.display = "none";

        video.src = URL.createObjectURL(file);
        video.style.display = "block";

    } else {

        video.pause();
        video.removeAttribute("src");
        video.style.display = "none";

        audio.src = URL.createObjectURL(file);
        audio.style.display = "block";
        audio.load();
        audio.pause();

    }

